{
  "name": "dsh-plugin-mimo-relay",
  "version": "0.5.0",
  "description": "Multi-agent relay for DeepSeek Harness: Planner→Builder→Verifier with role-scoped connector packs (planner/scout/builder/verifier presets), per-workspace connector locks, and a schema-checked handoff contract.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "relay",
    "multi-agent",
    "planner-builder-verifier"
  ],
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
